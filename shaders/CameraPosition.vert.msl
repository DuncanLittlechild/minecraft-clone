#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_MvpTrans
{
    float4x4 MoveTransform;
};

struct type_VpTrans
{
    float4x4 VpTransform;
};

struct main0_out
{
    float3 out_var_TEXCOORD1 [[user(locn0)]];
    float4 gl_Position [[position]];
};

struct main0_in
{
    float3 in_var_TEXCOORD0 [[attribute(0)]];
    float3 in_var_TEXCOORD1 [[attribute(1)]];
};

vertex main0_out main0(main0_in in [[stage_in]], constant type_MvpTrans& MvpTrans [[buffer(0)]], constant type_VpTrans& VpTrans [[buffer(1)]])
{
    main0_out out = {};
    out.gl_Position = (VpTrans.VpTransform * MvpTrans.MoveTransform) * float4(in.in_var_TEXCOORD0, 1.0);
    out.out_var_TEXCOORD1 = in.in_var_TEXCOORD1;
    return out;
}

