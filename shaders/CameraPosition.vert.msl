#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_MvpTrans
{
    float4x4 MoveTransform;
};

struct type_VpTrans
{
    float4x4 VpTransform;
};

struct type_TexIndex
{
    float TextureIndex;
};

struct main0_out
{
    float2 out_var_TEXCOORD0 [[user(locn0)]];
    float out_var_TEXCOORD1 [[user(locn1)]];
    float3 out_var_TEXCOORD2 [[user(locn2)]];
    float4 gl_Position [[position]];
};

struct main0_in
{
    float3 in_var_TEXCOORD0 [[attribute(0)]];
    float3 in_var_TEXCOORD1 [[attribute(1)]];
    float2 in_var_TEXCOORD2 [[attribute(2)]];
};

vertex main0_out main0(main0_in in [[stage_in]], constant type_MvpTrans& MvpTrans [[buffer(0)]], constant type_VpTrans& VpTrans [[buffer(1)]], constant type_TexIndex& TexIndex [[buffer(2)]])
{
    main0_out out = {};
    out.out_var_TEXCOORD0 = in.in_var_TEXCOORD2;
    out.out_var_TEXCOORD1 = TexIndex.TextureIndex;
    out.out_var_TEXCOORD2 = in.in_var_TEXCOORD1;
    out.gl_Position = (VpTrans.VpTransform * MvpTrans.MoveTransform) * float4(in.in_var_TEXCOORD0, 1.0);
    return out;
}

