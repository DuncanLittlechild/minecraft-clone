#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_VpTrans
{
    float4x4 VpTransform;
};

struct main0_out
{
    float2 out_var_TEXCOORD0 [[user(locn0)]];
    int out_var_TEXCOORD1 [[user(locn1)]];
    float4 gl_Position [[position]];
};

struct main0_in
{
    float3 in_var_TEXCOORD0 [[attribute(0)]];
    float2 in_var_TEXCOORD2 [[attribute(2)]];
    int in_var_TEXCOORD3 [[attribute(3)]];
};

vertex main0_out main0(main0_in in [[stage_in]], constant type_VpTrans& VpTrans [[buffer(0)]])
{
    main0_out out = {};
    out.out_var_TEXCOORD0 = in.in_var_TEXCOORD2;
    out.out_var_TEXCOORD1 = in.in_var_TEXCOORD3;
    out.gl_Position = VpTrans.VpTransform * float4(in.in_var_TEXCOORD0, 1.0);
    return out;
}

